{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_website}",
    "sources": "${mod_repository}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "accessWidener": "tinymobfarm.accesswidener",
  "entrypoints": {
    "main": [
      "com.daqem.tinymobfarm.fabric.TinyMobFarmCommonFabric"
    ],
    "client": [
      "com.daqem.tinymobfarm.fabric.TinyMobFarmClientFabric"
    ]
  },
  "mixins": [
    "tinymobfarm-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "java": ">=25",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "~${minecraft_version}",
    "yamlconfig": ">=${yamlconfig_version}",
    "uilib": ">=${uilib_version}"
  }
}
